# Copy to .env and fill in. Never commit .env.

# ---- AI (free key: https://aistudio.google.com/apikey). Without it the advisor runs in basic English/Hindi mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Supabase (see docs/SETUP_PRODUCTION.md)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=kyc-documents

# ---- Clerk. Setting CLERK_ISSUER turns authentication on. Leave empty ONLY for local development.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=

# ---- Razorpay (test keys rzp_test_..., then live keys). Leave empty to use the local test-mode stub.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Encryption key for KYC data and files. Generate once and back it up:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KYC_ENC_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Only for evaluating with the case's specimen documents (they are dated against this day)
# UDYAM_TODAY=2026-07-15
# ---- Showcase helpers: sample applicants and an auto-advancing order timer. Keep false in production.
DEMO_MODE=false
